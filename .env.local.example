# Laptop/demo configuration: Neon PostgreSQL + Qdrant + OpenRouter.
# scripts/local/setup.sh copies this to .env and fills the generated secrets.
# Never commit .env. Values here are read by the API, workers and Alembic.

# ---- Web app (loopback only; port 8080 is often taken by other local stacks) ----
APP_PORT=8088
APP_ORIGIN=http://localhost:8088
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
BOOTSTRAP_TOKEN=
CREDENTIAL_ENCRYPTION_KEY=

# ---- Neon PostgreSQL: system of record (users, chats, runs, documents, jobs) ----
# Use the DIRECT connection string (host without "-pooler") and change the scheme
# to postgresql+psycopg://. Keep sslmode=require. Example:
# DATABASE_URL=postgresql+psycopg://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ---- Vector search: Qdrant (PostgreSQL keeps the vectors and re-checks access) ----
VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
# Only for Qdrant Cloud; leave empty for the local binary/container.
QDRANT_API_KEY=
QDRANT_COLLECTION=optimus_knowledge

# ---- OpenRouter: three model levels ----
ALLOW_EXTERNAL_AI=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_STANDARD=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_DEEP=anthropic/claude-opus-5.5
# Optional extra models offered in menus, comma-separated.
# OPENROUTER_MODELS=
OPENROUTER_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=10485760
MAX_CONTEXT_CHARS=24000
MAX_OUTPUT_TOKENS=2048

EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32

# ---- Workers ----
# Each worker lane polls the database at this interval, which keeps a Neon
# compute awake while the app runs. Raise it if compute hours matter more than
# responsiveness, and stop the app when you are not using it.
WORKER_POLL_SECONDS=5
AGENT_MAX_MODEL_STEPS=5
AGENT_MAX_TOOL_CALLS=8

# ---- Optional integrations (leave empty until needed) ----
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.groq.com/openai/v1
SPEECH_MODEL=whisper-large-v3-turbo
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Laptop/demo configuration: Neon PostgreSQL + pgvector + hosted AI models.
# scripts/local/setup.sh copies this to .env and fills the generated secrets.
# Never commit .env. Values here are read by the API, workers and Alembic.

# ---- Web app (loopback only; port 8080 is often taken by other local stacks) ----
APP_PORT=8088
APP_ORIGIN=http://localhost:8088
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
BOOTSTRAP_TOKEN=
CREDENTIAL_ENCRYPTION_KEY=

# ---- Database: Neon PostgreSQL + pgvector (one branch per environment) ----
# Neon console -> Connect, pooling OFF (host without "-pooler"), then change
# postgresql:// to postgresql+psycopg://. The app uses DATABASE_URL;
# ./scripts/local/start.sh --env development uses DATABASE_URL_NEON_DEVELOPMENT.
# Environment for ./scripts/local/start.sh (overridable with --env): KEY_<ENV> lines
# apply as KEY for that run, e.g. GOOGLE_CLIENT_ID_DEMO -> GOOGLE_CLIENT_ID.
APP_ENV=demo
DATABASE_URL=
DATABASE_SCHEMA=public
DATABASE_URL_NEON_DEMO=
DATABASE_URL_NEON_DEVELOPMENT=
# Tests truncate every table: use only this branch for pytest.
DATABASE_URL_NEON_TEST=

# ---- Vector search ----
# pgvector ranks embeddings inside PostgreSQL, in the same query as the access checks.
# Optional alternative: VECTOR_BACKEND=qdrant (then run setup.sh --with-qdrant).
VECTOR_BACKEND=pgvector
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=optimus_knowledge

# ---- AI models: Fast / Medium Reasoning / High (never shown in the UI) ----
ALLOW_EXTERNAL_AI=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
OPENROUTER_MODEL_MEDIUM=anthropic/claude-sonnet-5.5
OPENROUTER_MODEL_HIGH=anthropic/claude-opus-5.5
# Optional extra models offered in menus, comma-separated.
# OPENROUTER_MODELS=
OPENROUTER_TIMEOUT_SECONDS=90
MAX_UPLOAD_BYTES=10485760
MAX_CONTEXT_CHARS=24000
MAX_OUTPUT_TOKENS=2048

EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32

# ---- Workers ----
# Each worker lane polls the database at this interval, which keeps a Neon
# compute awake while the app runs. Raise it if compute hours matter more than
# responsiveness, and stop the app when you are not using it.
WORKER_POLL_SECONDS=5
AGENT_MAX_MODEL_STEPS=5
AGENT_MAX_TOOL_CALLS=8

# ---- Optional integrations (leave empty until needed) ----
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.groq.com/openai/v1
SPEECH_MODEL=whisper-large-v3-turbo
# Google sign-in (Calendar, Drive, Meet): see docs/INTEGRATIONS.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft sign-in (Outlook, Teams transcripts): see docs/INTEGRATIONS.md
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
# Email: Hostinger uses smtp.hostinger.com, port 465, SMTP_SSL=true, SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

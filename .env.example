# scripts/start.sh generates .env, database password, credential key and setup token.
# Do not source this file as shell code. Docker Compose loads it directly.
COMPOSE_PROJECT_NAME=voptimai
COMPOSE_FILE=compose.yaml
APP_VERSION=local
APP_PORT=8080
POSTGRES_DB=voptimai
POSTGRES_USER=voptimai
POSTGRES_PASSWORD=
CREDENTIAL_ENCRYPTION_KEY=
BOOTSTRAP_TOKEN=

# Local loopback only. scripts/start.sh --tailscale sets private HTTPS and secure cookies.
APP_ORIGIN=http://localhost:8080
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Optional Caddy overlay for managed LAN TLS; not needed with Tailscale Serve.
APP_HOSTNAME=voptimai.lan
TLS_BIND_ADDRESS=0.0.0.0

# The startup prompt enables external AI when you supply a key.
ALLOW_EXTERNAL_AI=false
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-4.1-mini
OPENROUTER_DEFAULT_MODEL=openai/gpt-4.1-mini
OPENROUTER_TIMEOUT_SECONDS=90
# Optional three-level ladder; when set, these become the allowlist, Standard the
# default and Fast the classification/drafting model.
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_STANDARD=
OPENROUTER_MODEL_DEEP=
MAX_UPLOAD_BYTES=2097152
MAX_CONTEXT_CHARS=24000
MAX_OUTPUT_TOKENS=2048
AGENT_CHECKPOINT_RETENTION_DAYS=7
AGENT_MAX_MODEL_STEPS=5
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_ATTEMPTS=3
AGENT_LEASE_SECONDS=180
WORKER_POLL_SECONDS=5
JOB_LEASE_SECONDS=180

# Uses the same OpenRouter key; embedding text leaves the device when authorized.
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
# pgvector (default) or qdrant; PostgreSQL keeps vectors either way.
VECTOR_BACKEND=pgvector
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Optional Outlook: register a Microsoft Entra web app and its exact callback URL.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
CONNECTOR_TIMEOUT_SECONDS=30

# Optional voice capture: hosted OpenAI-compatible transcription endpoint.
# The supplied default is Groq; this requires its own SPEECH_API_KEY.
SPEECH_API_KEY=
SPEECH_BASE_URL=https://api.groq.com/openai/v1
SPEECH_MODEL=whisper-large-v3-turbo

# Optional email delivery; Teams Workflow URLs are configured in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
